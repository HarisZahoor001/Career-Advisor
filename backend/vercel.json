{
  "builds": [
    {
      "src": "backend/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/wsgi.py"
    }
  ],
  "env": {
    "PYTHONPATH": "/var/task:/var/task/backend",
    "DJANGO_SETTINGS_MODULE": "backend.settings",
    "VERCEL": "1"
  },
  "buildCommand": "bash vercel-build.sh",
  "installCommand": "pip install -r requirements.txt"
}